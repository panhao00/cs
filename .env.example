# ============================================
# CRS 课程注册系统 — Docker Compose 环境变量模板
# ============================================
# 使用: Copy-Item .env.example .env(然后按需编辑)
# 注意: 生产环境 JWT_SECRET 与 GRADE_ENCRYPTION_KEY 为必填,
#       缺失时 docker compose 会直接报错, 不会使用弱默认值。
#
# 生成密钥参考命令:
#   JWT_SECRET(≥32 字符):  任意强随机字符串即可
#   GRADE_ENCRYPTION_KEY:  openssl rand -base64 32

# JWT 签名密钥(必填, ≥32 字符)
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# 成绩加密密钥(必填, 32 字节 Base64)
GRADE_ENCRYPTION_KEY=

# MySQL root 密码(首次初始化时设置)
MYSQL_ROOT_PASSWORD=crs123456

# MySQL 应用用户密码(与 crs-mysql 服务 MYSQL_PASSWORD 保持一致)
MYSQL_PASSWORD=crs123456
