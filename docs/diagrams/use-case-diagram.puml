@startuml Wylie College 课程注册系统 - 用例图
' ========================================
' Wylie College 课程注册系统 (CRS)
' 用例图 - Use Case Diagram
' ========================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
  FontSize 13
}
skinparam actor {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 14
}
skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #4CAF50
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
}

title Wylie College 课程注册系统 (CRS) 用例图

rectangle "课程注册系统 (CRS)" as CRS {

  ' ========== 认证 ==========
  usecase "登录认证\n(Login)" as UC_Login
  usecase "输入用户名密码" as UC_InputCred
  usecase "验证身份" as UC_Verify
  usecase "生成JWT令牌" as UC_JWT

  UC_InputCred ..> UC_Verify : <<include>>
  UC_Verify ..> UC_JWT : <<include>>

  ' ========== 学生用例 ==========
  usecase "选课注册\n(Register for\nCourses)" as UC_Register
  usecase "创建课表" as UC_CreateSchedule
  usecase "选择课程开设\n(主选/备选)" as UC_SelectOffering
  usecase "提交课表" as UC_SubmitSchedule
  usecase "校验选课规则" as UC_ValidateRules
  usecase "查看成绩单\n(View Report Card)" as UC_ReportCard

  UC_Register ..> UC_CreateSchedule : <<include>>
  UC_Register ..> UC_SelectOffering : <<include>>
  UC_Register ..> UC_SubmitSchedule : <<include>>
  UC_SubmitSchedule ..> UC_ValidateRules : <<include>>

  ' ========== 学生扩展用例 ==========
  usecase "管理候补名单\n(Manage Waitlist)" as UC_Waitlist
  usecase "加入候补名单" as UC_JoinWaitlist
  usecase "取消候补名单" as UC_CancelWaitlist
  usecase "课程评价\n(Course Review)" as UC_CourseReview
  usecase "提交评价" as UC_SubmitReview
  usecase "修改评价" as UC_EditReview
  usecase "删除评价" as UC_DeleteReview
  usecase "课程推荐\n(Course Recommendation)" as UC_Recommendation
  usecase "查看GPA趋势\n(View GPA Trend)" as UC_GPATrend

  UC_Waitlist ..> UC_JoinWaitlist : <<include>>
  UC_Waitlist ..> UC_CancelWaitlist : <<include>>
  UC_CourseReview ..> UC_SubmitReview : <<include>>
  UC_CourseReview ..> UC_EditReview : <<include>>
  UC_CourseReview ..> UC_DeleteReview : <<include>>

  ' ========== 教授用例 ==========
  usecase "选择授课课程\n(Select Courses\nto Teach)" as UC_Teach
  usecase "提交成绩\n(Submit Grades)" as UC_Grades
  usecase "查看成绩分布\n(View Grade Distribution)" as UC_GradeDistribution

  ' ========== 注册主任用例 ==========
  usecase "维护学生信息\n(Maintain Student)" as UC_MaintainStudent
  usecase "维护教授信息\n(Maintain Professor)" as UC_MaintainProf
  usecase "关闭注册\n(Close Registration)" as UC_CloseReg
  usecase "查看审计日志" as UC_AuditLog
  usecase "系统设置\n(System Settings)" as UC_SystemSettings
  usecase "选课统计\n(Enrollment Statistics)" as UC_EnrollmentStats
}

' ========== 参与者 ==========
actor "学生\n(Student)" as Student
actor "教授\n(Professor)" as Professor
actor "注册主任\n(Registrar)" as Registrar

' ========== 学生关系 ==========
Student --> UC_Login
Student --> UC_Register
Student --> UC_ReportCard
Student --> UC_Waitlist
Student --> UC_CourseReview
Student --> UC_Recommendation
Student --> UC_GPATrend

' ========== 教授关系 ==========
Professor --> UC_Login
Professor --> UC_Teach
Professor --> UC_Grades
Professor --> UC_GradeDistribution

' ========== 注册主任关系 ==========
Registrar --> UC_Login
Registrar --> UC_MaintainStudent
Registrar --> UC_MaintainProf
Registrar --> UC_CloseReg
Registrar --> UC_AuditLog
Registrar --> UC_SystemSettings
Registrar --> UC_EnrollmentStats

' ========== 扩展关系 ==========
UC_Register ..> UC_CloseReg : <<extend>>\n注册截止后\n无法选课
UC_Teach ..> UC_CloseReg : <<extend>>\n注册截止后\n无法选课

' ========== 注释 ==========
note right of UC_ValidateRules
  校验内容:
  1. 先修课是否通过
  2. 课程容量是否已满
  3. 时间是否冲突
  4. 主选<=4门, 备选<=2门
end note

note bottom of UC_CloseReg
  关闭注册6步流程:
  1. 校验注册状态
  2. 检查教授指派+最小人数
  3. Leveling课表均衡
  4. 二次检查
  5. 通知Billing系统
  6. 通知所有学生
end note

note right of UC_ReportCard
  显示所有学期的
  课程、成绩、学分
end note

note left of UC_Waitlist
  候补名单功能:
  - 课程满员时加入候补
  - 有空位时自动通知
  - 可随时取消候补
end note

note right of UC_CourseReview
  课程评价功能:
  - 提交评分(1-5星)和评论
  - 修改/删除自己的评价
  - 查看课程平均评分
end note

note left of UC_Recommendation
  课程推荐功能:
  - 基于成绩和兴趣推荐
  - 考虑先修课完成情况
  - 个性化课程列表
end note

note right of UC_SystemSettings
  系统设置功能:
  - 配置选课时间窗口
  - 设置课程容量限制
  - 管理系统参数
end note

note left of UC_EnrollmentStats
  选课统计功能:
  - 查看课程报名热度
  - 各院系选课分布
  - 历史趋势分析
end note

note right of UC_GPATrend
  GPA趋势分析:
  - 学生:查看学期GPA变化
  - 教授:查看班级成绩分布
end note

@enduml
