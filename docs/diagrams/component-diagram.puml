@startuml Wylie College 课程注册系统 - 组件图
' ========================================
' Wylie College 课程注册系统 (CRS)
' 组件图/部署图 - Component/Deployment Diagram
' ========================================

skinparam component {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 12
}
skinparam node {
  BackgroundColor #E8F5E9
  BorderColor #4CAF50
  FontSize 13
}
skinparam database {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 12
}
skinparam cloud {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam package {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam artifact {
  BackgroundColor #FEFECE
  BorderColor #A80036
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
}

title Wylie College 课程注册系统 - 组件图/部署图


' ========== 客户端层 ==========
node "客户端" as Client {
  artifact "Web浏览器\n(Chrome/Firefox/Edge)" as Browser
}

' ========== 前端层 ==========
node "前端服务器" as FrontendNode {
  package "Vue 3 前端应用" as VueApp {
    artifact "Vite 5.x\n构建工具" as Vite
    artifact "Vue Router 4.x\n路由守卫" as Router
    artifact "Pinia 2.x\n状态管理" as Pinia
    artifact "Axios 1.x\nHTTP客户端" as Axios
    artifact "Element Plus 2.x\nUI组件库" as ElementUI
    artifact "Vue 3.x\n组合式API" as Vue3
  }
}

' ========== 后端层 ==========
node "后端服务器 (Spring Boot 3.3)" as BackendNode {

  package "安全模块" as SecurityPkg {
    artifact "Spring Security 6.x\n角色授权" as SpringSec
    artifact "JwtTokenProvider\nJWT生成/校验" as JWT
    artifact "JwtAuthenticationFilter\n请求拦截" as JWTFilter
    artifact "BCrypt\n密码哈希" as BCrypt
  }

  package "控制器层 (18个Controller)" as CtrlPkg {
   package "账户/课程控制器" as CtrlGrp1 {
    artifact "AuthController\n登录认证" as AuthCtrl
    artifact "ScheduleController\n课表管理" as SchedCtrl
    artifact "TeachingController\n教授选课" as TeachCtrl
    artifact "GradeController\n成绩录入" as GradeCtrl
    artifact "UserController\n用户管理" as UserCtrl
    artifact "RegistrationController\n关闭注册" as RegCtrl
   }
   package "教学/成绩控制器" as CtrlGrp2 {
    artifact "ReportCardController\n成绩单" as ReportCtrl
    artifact "CatalogController\n课程目录" as CatCtrl
    artifact "NotificationController\n通知" as NotiCtrl
   }
   package "扩展业务控制器" as CtrlGrp3 {
    artifact "HealthController\n健康检查" as HealthCtrl
    artifact "WaitlistController\n候补名单" as WaitlistCtrl
    artifact "ReviewController\n课程评价" as ReviewCtrl
    artifact "RecommendationController\n课程推荐" as RecCtrl
    artifact "EnrollmentStatsController\n选课统计" as EnrollStatsCtrl
    artifact "GradeStatsController\n成绩统计" as GradeStatsCtrl
    artifact "SystemSettingController\n系统设置" as SysSettingCtrl
    artifact "AuditLogController\n审计日志查询" as AuditLogCtrl
    artifact "DeadlineReminderController\n截止日期提醒" as DeadlineCtrl
   }
  }

  package "服务层 (21个Service)" as SvcPkg {
   package "核心业务服务" as SvcGrp1 {
    artifact "AuthService\n登录认证" as AuthSvc
    artifact "ScheduleService\n选课逻辑" as SchedSvc
    artifact "TeachingService\n授课逻辑" as TeachSvc
    artifact "GradeService\n成绩逻辑" as GradeSvc
    artifact "UserService\n用户CRUD" as UserSvc
    artifact "RegistrationService\n关闭注册" as RegSvc
    artifact "ReportCardService\n成绩单查询" as ReportSvc
    artifact "CatalogService\n课程目录" as CatSvc
    artifact "NotificationService\n通知管理" as NotiSvc
   }
   package "审计/系统服务" as SvcGrp2 {
    artifact "AuditService\n审计日志" as AuditSvc
    artifact "WaitlistService\n候补名单管理" as WaitlistSvc
    artifact "ReviewService\n课程评价管理" as ReviewSvc
    artifact "RecommendationService\n课程推荐" as RecSvc
    artifact "EnrollmentStatsService\n选课统计" as EnrollStatsSvc
    artifact "GradeStatsService\n成绩统计" as GradeStatsSvc
    artifact "SystemSettingService\n系统设置" as SysSettingSvc
    artifact "AuditLogQueryService\n审计日志查询" as AuditLogSvc
   }
   package "异步/计费服务" as SvcGrp3 {
    artifact "BillingAsyncService\n异步计费(@Async)" as BillAsyncSvc
    artifact "BillingRetryService\n计费重试" as BillRetrySvc
    artifact "CapacityNotificationService\n容量预警通知" as CapNotiSvc
    artifact "DeadlineReminderService\n截止日期提醒" as DeadlineSvc
   }
  }

  package "数据访问层" as DAPkg {
    artifact "Spring Data JPA\nHibernate实现" as JPA
    artifact "RegistrationPhase\n注册阶段状态机" as RegPhase
    artifact "TimeConflictUtil\n时间冲突检测" as TimeUtil
  }

  package "适配器层 (Catalog Adapter)" as AdapterPkg {
    artifact "CatalogAdapter\n课程目录适配器接口" as CatAdapter
    artifact "LegacyCatalogAdapter\n遗留Ingres系统适配器" as LegacyCat
    artifact "CachedCatalogAdapter\n缓存装饰器" as CachedCat
    artifact "DirectCatalogAdapter\n直接数据库适配器" as DirectCat
  }

  package "基础设施" as InfraPkg {
    artifact "WebSocket\n实时通知\n(SockJS + STOMP)" as WebSocket
    artifact "@Async\n异步任务支持" as AsyncInfra
  }
}

' ========== 数据库层 ==========
database "H2 内存库\n(开发环境)\njdbc:h2:mem:crs" as H2
database "MySQL 8.x\n(生产环境)" as MySQL

' ========== 外部系统 ==========
cloud "外部系统" as ExternalPkg {
  artifact "Billing System\n账单系统\n(模拟调用)" as Billing
}

' ========== 连接关系 ==========
Browser --> Vue3 : HTTP/HTTPS\nREST API

Vite --> Vue3 : 构建打包
Vue3 --> Router : 路由管理
Vue3 --> Pinia : 状态管理
Vue3 --> Axios : HTTP请求
Vue3 --> ElementUI : UI组件

Axios --> AuthCtrl : REST API + JWT\nAuthorization: Bearer

AuthCtrl --> AuthSvc : 调用
SchedCtrl --> SchedSvc : 调用
TeachCtrl --> TeachSvc : 调用
GradeCtrl --> GradeSvc : 调用
UserCtrl --> UserSvc : 调用
RegCtrl --> RegSvc : 调用
ReportCtrl --> ReportSvc : 调用
CatCtrl --> CatSvc : 调用
NotiCtrl --> NotiSvc : 调用

WaitlistCtrl --> WaitlistSvc : 调用
ReviewCtrl --> ReviewSvc : 调用
RecCtrl --> RecSvc : 调用
EnrollStatsCtrl --> EnrollStatsSvc : 调用
GradeStatsCtrl --> GradeStatsSvc : 调用
SysSettingCtrl --> SysSettingSvc : 调用
AuditLogCtrl --> AuditLogSvc : 调用
DeadlineCtrl --> DeadlineSvc : 调用

AuthSvc --> SpringSec : 认证
AuthSvc --> JWT : 生成令牌
AuthSvc --> BCrypt : 密码比对
AuthSvc --> AuditSvc : 记录登录

SchedSvc --> JPA : 数据访问
TeachSvc --> JPA : 数据访问
GradeSvc --> JPA : 数据访问
UserSvc --> JPA : 数据访问
RegSvc --> JPA : 数据访问
ReportSvc --> JPA : 数据访问
CatSvc --> JPA : 数据访问
NotiSvc --> JPA : 数据访问

WaitlistSvc --> JPA : 数据访问
ReviewSvc --> JPA : 数据访问
RecSvc --> JPA : 数据访问
EnrollStatsSvc --> JPA : 数据访问
GradeStatsSvc --> JPA : 数据访问
SysSettingSvc --> JPA : 数据访问
AuditLogSvc --> JPA : 数据访问
BillAsyncSvc --> JPA : 数据访问
BillRetrySvc --> BillAsyncSvc : 重试调用
CapNotiSvc --> NotiSvc : 容量预警
CapNotiSvc --> WebSocket : 实时推送
DeadlineSvc --> NotiSvc : 提醒通知
DeadlineSvc --> WebSocket : 实时推送

CatSvc --> CatAdapter : 课程目录查询
CachedCat --> LegacyCat : 装饰(缓存)
CachedCat --> DirectCat : 装饰(缓存)
CatAdapter <|.. LegacyCat : 实现
CatAdapter <|.. CachedCat : 实现
CatAdapter <|.. DirectCat : 实现
LegacyCat --> JPA : 遗留数据
DirectCat --> JPA : 直接查询

BillAsyncSvc ..> AsyncInfra : 异步执行
NotiSvc --> WebSocket : 推送通知

SchedSvc --> NotiSvc : 选课通知
SchedSvc --> AuditSvc : 审计日志
TeachSvc --> AuditSvc : 审计日志
GradeSvc --> NotiSvc : 成绩通知
GradeSvc --> AuditSvc : 审计日志
UserSvc --> AuditSvc : 审计日志
RegSvc --> NotiSvc : 关闭通知
ReportSvc --> AuditSvc : 查看记录

RegSvc --> RegPhase : 阶段校验
SchedSvc --> TimeUtil : 冲突检测
TeachSvc --> TimeUtil : 冲突检测

SchedSvc ..> Billing : HTTP模拟调用
BillAsyncSvc ..> Billing : 异步HTTP调用

' ========== 部署视图 ==========
note as N1
  **部署架构说明**
  ==
  **开发环境:**
  浏览器(localhost:5173)
    -> Vite Dev Server (proxy)
    -> Spring Boot (localhost:8080)
    -> H2 内存库 (jdbc:h2:mem:crs)

  **生产环境:**
  浏览器/客户端
    -> Nginx (反向代理 + 静态资源)
    -> Spring Boot (应用服务器)
    -> MySQL 8.x (主库)
    -> Billing System (HTTP API)

  **新增组件:**
  - 服务层: 21个Service (含候补/评价/推荐/统计/异步计费等)
  - 控制器层: 18个Controller
  - 适配器层: CatalogAdapter接口 + 3个实现
  - 基础设施: WebSocket(SockJS+STOMP) + @Async异步支持
end note

@enduml